#!/bin/sh
# ja1md -- JOB AID 1 MAKE: a checklist people step through together, from one plain-text file anyone can edit.
#   Each step says what to DO, WHY (one line of context, so the people doing it know what they are doing as they
#   do it), how to CHECK it worked, and what STOPS the run. The same file renders to markdown (for a repository)
#   and to an HTML page (a checklist with boxes, on the egad palette, light and dark).
#
# usage: sh ja1md check FILE        every step has a why and a check; says how many steps, and where any is short
#        sh ja1md md FILE           the job aid as markdown
#        sh ja1md html FILE         the job aid as an HTML page body (an Artifact; title and style at its top)
#        sh ja1md --prove-red       plant faults; each must be caught
# Exit: 0 fine; 1 a step without its why or check (check), or a planted fault missed (--prove-red); 2 usage.
#
# The file:
#   # title: Submit the skills plugin          (required; the page's name)
#   # for: who steps through it, and how       (optional; a line under the title)
#   # id: short-stable-id                      (optional; keeps ticked boxes apart between job aids)
#   # note: anything said once, above the steps (optional; repeatable)
#   ## A section heading
#   - A step, said as what to do, in a few words
#     do: the exact thing: the screen, the button, the words to type
#     why: one line of context
#     check: what you see when it worked
#     stop: what means stop here, and what to do then   (optional)
#   Cells may repeat (two do: lines are two lines). Lines starting with ";" are comments.
#
# Born 2026-10-18 for Corwin and Bryant's first directory submission (his words: "a job aid for us to step
# though the task in terms of checklist back with crisp (brief, clear) contextualization so we understand what
# we are doing as we do it"); run-card's "help me run this" entry point uses it for work done at a screen.
# Copyright 2026 Corwin Brust <corwin@bru.st> and Contributors.  Authored by Mentat (for Corwin, opus-5-5).
# SPDX-License-Identifier: GPL-3.0-or-later OR LGPL-3.0-or-later
set -u
me=ja1md
here=$(cd "$(dirname "$0")" && pwd)

parse='
function esc(s) { gsub(/&/, "\\&amp;", s); gsub(/</, "\\&lt;", s); gsub(/>/, "\\&gt;", s); gsub(/"/, "\\&quot;", s); return s }
function code(s,   out, i, n, parts) {   # `text` -> <code>text</code>, after escaping
  s = esc(s); out = ""; n = split(s, parts, "`")
  for (i = 1; i <= n; i++) out = out ((i % 2 == 0) ? "<code>" parts[i] "</code>" : parts[i])
  return out }
/^;/ { next }
/^# *title:/ { t = $0; sub(/^# *title: */, "", t); title = t; next }
/^# *for:/ { t = $0; sub(/^# *for: */, "", t); who = t; next }
/^# *id:/ { t = $0; sub(/^# *id: */, "", t); id = t; next }
/^# *note:/ { t = $0; sub(/^# *note: */, "", t); notes[++nn] = t; next }
/^## / { t = $0; sub(/^## */, "", t); sec[++ns] = t; next }
/^- / { t = $0; sub(/^- */, "", t); st[++n] = t; ss[n] = ns; ln[n] = NR; next }
/^[ \t]+(do|why|check|stop):/ {
  if (!n) { bad = bad "line " NR ": a " $1 " before any step\n"; next }
  k = $1; sub(/:$/, "", k); t = $0; sub(/^[ \t]+[a-z]+: */, "", t)
  c[n, k] = (c[n, k] == "") ? t : c[n, k] "\n" t; next }
/^[ \t]*$/ { next }
{ bad = bad "line " NR ": not a step, cell, heading or header: " $0 "\n" }
'

check() {
  awk "$parse"'
  END {
    if (title == "") bad = bad "no # title: line\n"
    for (i = 1; i <= n; i++) {
      if (c[i, "why"] == "") bad = bad "line " ln[i] ": step \"" st[i] "\" has no why\n"
      if (c[i, "check"] == "") bad = bad "line " ln[i] ": step \"" st[i] "\" has no check\n"
    }
    if (n == 0) bad = bad "no steps\n"
    printf "%s", bad
    if (bad != "") { print "ja1md: NOT READY"; exit 1 }
    s = 0; for (i = 1; i <= n; i++) if (c[i, "stop"] != "") s++
    printf "ja1md: %s: %d steps in %d sections; every step has a why and a check; %d say what stops them\n", title, n, ns, s
  }' "$1"; }

md() {
  awk "$parse"'
  END {
    print "# " title; print ""
    if (who != "") { print "*" who "*"; print "" }
    for (i = 1; i <= nn; i++) { print notes[i]; print "" }
    cur = -1
    for (i = 1; i <= n; i++) {
      if (ss[i] != cur) { cur = ss[i]; if (cur) { print "## " sec[cur]; print "" } }
      print "- [ ] **" st[i] "**"
      split("do why check stop", ks, " ")
      for (j = 1; j <= 4; j++) {
        k = ks[j]; if (c[i, k] == "") continue
        m = split(c[i, k], L, "\n")
        for (x = 1; x <= m; x++) print "  - *" (x == 1 ? toupper(substr(k, 1, 1)) substr(k, 2) : "") (x == 1 ? ":* " : "*") L[x]
      }
      print ""
    }
    print "Made with ja1md (run-card) from its plain-text source."
  }' "$1" | sed 's/^  - \*\*\(.\)/  - \1/'; }

html() {
  awk "$parse"'
  END {
    if (id == "") { id = tolower(title); gsub(/[^a-z0-9]+/, "-", id) }
    printf "<title>%s</title>\n", esc(title)
    print "<meta name=\"claude:viewport-fit-sides\" content=\"cover\">"
    print "<style>"
    print "/* egad (Modus operandi / vivendi): square corners, a 2px focus ring, system faces. One column of steps. */"
    print ":root { --bg:#ffffff; --bg-dim:#f2f2f2; --fg:#000000; --fg-dim:#595959; --link:#0031a9; --border:#595959;"
    print "  --divider:#9f9f9f; --ok:#006800; --stop:#a60000; --alt:#193668;"
    print "  --sans: system-ui, -apple-system, \"Segoe UI\", Roboto, \"Noto Sans\", sans-serif;"
    print "  --mono: ui-monospace, \"Cascadia Mono\", Menlo, Consolas, \"Liberation Mono\", monospace; }"
    print "@media (prefers-color-scheme: dark) { :root:not([data-theme=\"light\"]) { --bg:#000000; --bg-dim:#1e1e1e; --fg:#ffffff;"
    print "  --fg-dim:#989898; --link:#2fafff; --border:#989898; --divider:#646464; --ok:#44bc44; --stop:#ff5f59; --alt:#c6daff; color-scheme: dark } }"
    print ":root[data-theme=\"dark\"] { --bg:#000000; --bg-dim:#1e1e1e; --fg:#ffffff; --fg-dim:#989898; --link:#2fafff; --border:#989898;"
    print "  --divider:#646464; --ok:#44bc44; --stop:#ff5f59; --alt:#c6daff; color-scheme: dark }"
    print "body { background: var(--bg); color: var(--fg); font: 16px/1.5 var(--sans);"
    print "  padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); padding-block: 24px 48px }"
    print "main { max-width: 46rem; margin: 0 auto; display: grid; gap: 28px }"
    print "header { display: grid; gap: 6px; border-bottom: 2px solid var(--fg); padding-bottom: 14px }"
    print "h1 { font-size: 1.75rem; line-height: 1.2; margin: 0; text-wrap: balance }"
    print ".for { color: var(--fg-dim); margin: 0 }"
    print ".bar { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between; font-variant-numeric: tabular-nums }"
    print ".count { font-weight: 600 } .count b { color: var(--ok) }"
    print "button { font: inherit; background: var(--bg); color: var(--fg); border: 1px solid var(--border); border-radius: 0; padding: 6px 12px; min-height: 44px; cursor: pointer }"
    print "button:hover { background: var(--bg-dim) }"
    print ":focus-visible { outline: 2px solid var(--link); outline-offset: 2px }"
    print ".notes p { margin: 0 0 8px; max-width: 65ch }"
    print "section { display: grid; gap: 12px }"
    print "h2 { font-size: .8rem; letter-spacing: .08em; text-transform: uppercase; color: var(--alt); margin: 0; border-bottom: 1px solid var(--divider); padding-bottom: 4px }"
    print "ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; counter-reset: step var(--start) }"
    print "li { border: 1px solid var(--divider); padding: 12px 14px; display: grid; gap: 8px; counter-increment: step; min-width: 0 }"
    print "li.done { border-color: var(--ok); background: var(--bg-dim) }"
    print "label.step { display: flex; gap: 12px; align-items: flex-start; font-weight: 600; cursor: pointer; min-height: 44px }"
    print "label.step::before { content: counter(step); font-variant-numeric: tabular-nums; color: var(--fg-dim); min-width: 1.6em; padding-top: 2px }"
    print "input[type=checkbox] { width: 22px; height: 22px; margin: 2px 0 0; accent-color: var(--ok); flex: none }"
    print "li.done label.step span { text-decoration: line-through; text-decoration-color: var(--ok) }"
    print "dl { display: grid; grid-template-columns: 4.5rem 1fr; gap: 4px 12px; margin: 0 0 0 calc(1.6em + 34px) }"
    print "@media (max-width: 480px) { dl { grid-template-columns: 1fr; margin-left: 0 } dd { margin-bottom: 6px } }"
    print "dt { font-size: .75rem; letter-spacing: .06em; text-transform: uppercase; color: var(--fg-dim); padding-top: 3px }"
    print "dd { margin: 0; min-width: 0; overflow-wrap: anywhere } dd p { margin: 0 }"
    print "dt.stop, dd.stop { color: var(--stop) }"
    print "code { font-family: var(--mono); font-size: .92em; background: var(--bg-dim); padding: 0 3px }"
    print "footer { color: var(--fg-dim); font-size: .85rem; border-top: 1px solid var(--divider); padding-top: 10px }"
    print "@media (prefers-reduced-motion: no-preference) { li { transition: border-color .15s, background-color .15s } }"
    print "</style>"
    printf "<main data-aid=\"%s\">\n<header>\n<h1>%s</h1>\n", esc(id), esc(title)
    if (who != "") printf "<p class=\"for\">%s</p>\n", code(who)
    printf "<div class=\"bar\"><span class=\"count\" aria-live=\"polite\"><b id=\"done\">0</b> of %d done</span>", n
    print "<button type=\"button\" id=\"reset\">Clear the boxes</button></div>\n</header>"
    if (nn) { print "<div class=\"notes\">"; for (i = 1; i <= nn; i++) printf "<p>%s</p>\n", code(notes[i]); print "</div>" }
    cur = -1; open = 0
    for (i = 1; i <= n; i++) {
      if (ss[i] != cur) {
        if (open) print "</ol></section>"
        cur = ss[i]; open = 1
        printf "<section>%s<ol style=\"--start:%d\">\n", (cur ? "<h2>" esc(sec[cur]) "</h2>" : ""), i - 1
      }
      printf "<li id=\"s%d\"><label class=\"step\"><input type=\"checkbox\" id=\"c%d\"><span>%s</span></label>\n<dl>\n", i, i, code(st[i])
      split("do why check stop", ks, " ")
      for (j = 1; j <= 4; j++) {
        k = ks[j]; if (c[i, k] == "") continue
        m = split(c[i, k], L, "\n"); body = ""
        for (x = 1; x <= m; x++) body = body "<p>" code(L[x]) "</p>"
        printf "<dt class=\"%s\">%s</dt><dd class=\"%s\">%s</dd>\n", k, k, k, body
      }
      print "</dl></li>"
    }
    if (open) print "</ol></section>"
    print "<footer>Each box is remembered in this browser only. Made with ja1md (run-card) from its plain-text source.</footer>\n</main>"
    print "<script>"
    print "(function () {"
    print "  var aid = document.querySelector(\"main\").getAttribute(\"data-aid\"), key = \"ja1md:\" + aid;"
    print "  var boxes = Array.prototype.slice.call(document.querySelectorAll(\"input[type=checkbox]\"));"
    print "  var saved = {}; try { saved = JSON.parse(localStorage.getItem(key) || \"{}\") || {}; } catch (e) { saved = {}; }"
    print "  function paint() { var d = 0; boxes.forEach(function (b) { b.closest(\"li\").classList.toggle(\"done\", b.checked); if (b.checked) d++; });"
    print "    document.getElementById(\"done\").textContent = d; }"
    print "  function save() { var s = {}; boxes.forEach(function (b) { if (b.checked) s[b.id] = 1; }); try { localStorage.setItem(key, JSON.stringify(s)); } catch (e) {} }"
    print "  boxes.forEach(function (b) { b.checked = !!saved[b.id]; b.addEventListener(\"change\", function () { paint(); save(); }); });"
    print "  document.getElementById(\"reset\").addEventListener(\"click\", function () { boxes.forEach(function (b) { b.checked = false; }); paint(); save(); });"
    print "  paint();"
    print "})();"
    print "</script>"
  }' "$1"; }

prove_red() {
  t=$(mktemp -d 2>/dev/null) || exit 2
  trap 'rm -rf "$t"' EXIT INT TERM
  fails=0
  printf '# title: T\n## S\n- A\n  do: x\n  why: y\n  check: z\n  stop: w\n- B\n  why: y\n  check: z\n' > "$t/good"
  sh "$0" check "$t/good" >/dev/null 2>&1 && echo "  ok   a whole file is ready" || { echo "  FAIL a whole file"; fails=$((fails+1)); }
  sed '/^  why: y$/{x;s/^/./;/^\.$/{x;d};x}' "$t/good" > "$t/nowhy"
  sh "$0" check "$t/nowhy" >/dev/null 2>&1 && { echo "  FAIL a step with no why passed"; fails=$((fails+1)); } || echo "  ok   a step with no why is caught"
  grep -v '^  check: z$' "$t/good" > "$t/nocheck"
  sh "$0" check "$t/nocheck" >/dev/null 2>&1 && { echo "  FAIL a step with no check passed"; fails=$((fails+1)); } || echo "  ok   a step with no check is caught"
  grep -v '^# title' "$t/good" > "$t/notitle"
  sh "$0" check "$t/notitle" >/dev/null 2>&1 && { echo "  FAIL no title passed"; fails=$((fails+1)); } || echo "  ok   a file with no title is caught"
  printf 'stray words\n' >> "$t/good2"; cat "$t/good" "$t/good2" > "$t/stray"
  sh "$0" check "$t/stray" >/dev/null 2>&1 && { echo "  FAIL a stray line passed"; fails=$((fails+1)); } || echo "  ok   a line that is no part of the form is caught"
  printf '# title: T <b>\n- A `x<y`\n  why: a & b\n  check: c\n' > "$t/esc"
  sh "$0" html "$t/esc" > "$t/o.html"
  grep -q '<code>x&lt;y</code>' "$t/o.html" && grep -q 'a &amp; b' "$t/o.html" && ! grep -q 'T <b>' "$t/o.html" \
    && echo "  ok   words are escaped in the page, and backticks become code" || { echo "  FAIL escaping"; fails=$((fails+1)); }
  n=$(sh "$0" html "$t/good" | grep -c 'type="checkbox"')
  [ "$n" -eq 2 ] && echo "  ok   one box per step" || { echo "  FAIL $n boxes for 2 steps"; fails=$((fails+1)); }
  sh "$0" md "$t/good" | grep -q '^- \[ \] \*\*A\*\*' && echo "  ok   the markdown has one box per step" || { echo "  FAIL markdown boxes"; fails=$((fails+1)); }
  [ $fails -eq 0 ] && { echo "$me: PROVE-RED OK"; return 0; } || { echo "$me: PROVE-RED FAILED ($fails)"; return 1; }; }

case ${1:-} in
  check|md|html) [ $# -eq 2 ] && [ -r "$2" ] || { sed -n '2,12p' "$0"; exit 2; }; "$1" "$2" ;;
  --prove-red) prove_red ;;
  *) sed -n '2,12p' "$0"; exit 2 ;;
esac
