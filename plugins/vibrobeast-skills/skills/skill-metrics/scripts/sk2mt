#!/bin/sh
# sk2mt -- SKILL 2 METRICS TABLE. The garden's time-series of interesting events, one row each.
#
# THE NAME, declared as my reading (AS4CE pattern, run-level in the middle; a guess, marked):
#   SK  SKILL      -- the subject: each thing the garden ships under one user-facing name
#   2   run-level 2 -- writes, but only inside its own store; never outside it
#   MT  METRICS TABLE -- what it keeps
#
# THE STORE (see ../SPEC.md for the whole contract):
#   ROOT/log                   header `ITEM STATE CUR LAST DATE NOTE`, then one row per event.
#                              Fields 1-5 never contain a space; NOTE is the rest of the line.
#   ROOT/skill-metrics/ITEM    one line: the last STATE of ITEM. `cat` answers on its own.
#   ROOT/archive/ITEM/H-NAME   archived versions of ITEM's constituent, keyed on content
#                              (H = first 16 hex of sha256). CUR and LAST name these, or NONE.
#
# ROOT is -C DIR, else $SKILL_METRICS_ROOT, else ./metrics. A root YOU named is never created
# behind your back: only `init` creates one. From inside, a typo and a first run look the same.
#
# usage:
#   sk2mt [-C ROOT] init
#   sk2mt [-C ROOT] set ITEM STATE [--file PATH] [--note TEXT] [--date UTC] [--force]
#   sk2mt [-C ROOT] FIELD [SELECT] [NAME ...]      FIELD: state cur last date note row
#   sk2mt [-C ROOT] items|log|say|table [SELECT] [NAME ...]
#   sk2mt [-C ROOT] check
#
# SELECT models POSIX grep, applied to the list of item names (NOT to row text):
#   NAME ...     exact names (grep -F -x); a word list      -e PAT   pattern (repeatable)
#   -f FILE      patterns from FILE, one per line           -E / -F / -G   ERE / fixed / BRE (default)
#   -i  ignore case   -v  invert   -x  whole-name match   -c  count   -l  names only   -q  quiet
#   --state WORD   then keep only items whose last STATE is exactly WORD ("which are RED?")
# No NAME and no -e/-f selects every item. GNU's -w is deliberately absent: item names carry `-`
# and `.`, so GNU "word" matching would find `layered` inside `gf-02-layered-assurance`.
# Exit (grep's): 0 something selected · 1 nothing selected · 2 usage or store error · 3 NOTVISIBLE.
#
# Copyright 2026 Corwin Brust <corwin@bru.st> -- GPLv3-or-later. Authored by Mentat (for Corwin).
#
# SPDX-License-Identifier: GPL-3.0-or-later
# This file is part of vibrobeast.  vibrobeast is free software: you can redistribute it and/or
# modify it under the terms of the GNU General Public License as published by the Free Software
# Foundation, either version 3 of the License, or (at your option) any later version.  It is
# distributed WITHOUT ANY WARRANTY; see <https://www.gnu.org/licenses/>.
set -u
LC_ALL=C; export LC_ALL
SL_PROG=sk2mt
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 2
. "$here/sh1lib.sh"

HEADER='ITEM STATE CUR LAST DATE NOTE'
ITEM_RE='[A-Za-z0-9][A-Za-z0-9._+-]*'
STATE_RE='[A-Za-z0-9][A-Za-z0-9._:+%-]*'
DATE_RE='[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z'

usage() { sed -n '/^# usage:/,/^# Exit/p' "$0" | sed 's/^# \{0,1\}//'; }

ROOT=${SKILL_METRICS_ROOT:-./metrics}
while [ $# -gt 0 ]; do
  case $1 in
    -C) [ $# -ge 2 ] || sl_die "-C needs a directory"; ROOT=$2; shift 2 ;;
    -h|--help|help) usage; exit 0 ;;
    *) break ;;
  esac
done
[ $# -ge 1 ] || { usage >&2; exit 2; }
CMD=$1; shift
LOG=$ROOT/log; ITEMS=$ROOT/skill-metrics; ARC=$ROOT/archive

need_store() {
  [ -d "$ROOT" ] && [ -f "$LOG" ] && [ -d "$ITEMS" ] || {
    printf 'sk2mt: NOTVISIBLE -- no metrics store at %s (want %s and %s/). Run `sk2mt -C %s init` if you meant a new one.\n' \
      "$ROOT" "$LOG" "$ITEMS" "$ROOT" >&2; exit 3; }
  [ "$(sed -n 1p "$LOG")" = "$HEADER" ] || sl_die "$LOG: first line is not the header '$HEADER'"
}

# latest ITEM -> its most recent row, or nothing
latest() { awk -v it="$1" 'NR > 1 && $1 == it { row = $0 } END { if (row != "") print row }' "$LOG"; }

# field N ROW -> the Nth field; N=6 is the NOTE (rest of the line)
field() {
  printf '%s\n' "$2" | awk -v n="$1" '{
    if (n < 6) { print $n; exit }
    s = $0; for (i = 1; i <= 5; i++) sub(/^[^ ]+ /, "", s); print s }'
}

cmd_init() {
  mkdir -p "$ITEMS" "$ARC" || sl_die "cannot create $ROOT"
  if [ -f "$LOG" ]; then
    [ "$(sed -n 1p "$LOG")" = "$HEADER" ] || sl_die "$LOG exists and its first line is not the header"
    echo "sk2mt: store already at $ROOT"
  else
    printf '%s\n' "$HEADER" > "$LOG"; echo "sk2mt: new store at $ROOT"
  fi
}

cmd_set() {
  [ $# -ge 2 ] || sl_die "set needs ITEM STATE"
  item=$1 state=$2; shift 2
  file='' note='' date='' force=0
  while [ $# -gt 0 ]; do
    case $1 in
      --file) [ $# -ge 2 ] || sl_die "--file needs a path"; file=$2; shift 2 ;;
      --note) [ $# -ge 2 ] || sl_die "--note needs text"; note=$2; shift 2 ;;
      --date) [ $# -ge 2 ] || sl_die "--date needs a UTC stamp"; date=$2; shift 2 ;;
      --force) force=1; shift ;;
      *) sl_die "set: unknown argument: $1" ;;
    esac
  done
  sl_match "$ITEM_RE" "$item"   || sl_die "bad ITEM '$item' (want $ITEM_RE)"
  sl_match "$STATE_RE" "$state" || sl_die "bad STATE '$state' (want $STATE_RE)"
  [ -n "$date" ] || date=$(sl_utc)
  sl_match "$DATE_RE" "$date"   || sl_die "bad --date '$date' (want YYYY-MM-DDTHH:MM:SSZ)"
  note=$(printf '%s' "$note" | tr '\t\r\n' '   ' | sed 's/  */ /g; s/^ //; s/ $//')
  [ -n "$note" ] || note=-
  need_store

  prev=$(latest "$item")
  if [ -n "$prev" ]; then
    pstate=$(field 2 "$prev"); pcur=$(field 3 "$prev"); plast=$(field 4 "$prev")
  else pstate=''; pcur=NONE; plast=NONE; fi

  if [ -n "$file" ]; then
    [ -f "$file" ] || sl_die "--file is not a file: $file"
    h=$(sl_hash "$file") || exit 2; h=$(printf '%s' "$h" | cut -c1-16)
    base=$(printf '%s' "${file##*/}" | tr -c 'A-Za-z0-9._+-' '_')
    cur=archive/$item/$h-$base
    if [ -f "$ROOT/$cur" ]; then
      [ "$(sl_hash "$ROOT/$cur" | cut -c1-16)" = "$h" ] || sl_die "archive copy $cur no longer matches its own name -- run check"
    else
      mkdir -p "$ARC/$item" && cp "$file" "$ROOT/$cur.tmp.$$" && mv -f "$ROOT/$cur.tmp.$$" "$ROOT/$cur" \
        || sl_die "could not archive $file"
    fi
    if [ "$cur" = "$pcur" ]; then last=$plast; else last=$pcur; fi
  else
    cur=$pcur; last=$plast
  fi

  if [ -n "$prev" ] && [ "$state" = "$pstate" ] && [ "$cur" = "$pcur" ] && [ $force -eq 0 ]; then
    printf '%s\n' "$state" | sl_write_atomic "$ITEMS/$item"
    echo "UNCHANGED $item $state (no row written: state and constituent are what the log already says)"
    return 0
  fi
  printf '%s %s %s %s %s %s\n' "$item" "$state" "$cur" "$last" "$date" "$note" >> "$LOG" || sl_die "cannot append to $LOG"
  printf '%s\n' "$state" | sl_write_atomic "$ITEMS/$item" || sl_die "cannot write $ITEMS/$item"
  echo "LOGGED $item $state $cur $last $date"
}

# ---- selection: POSIX-grep semantics over the list of item names --------------------------------
PATS='' PFILE='' MODE=G ICASE=0 INV=0 WHOLE=0 COUNT=0 NAMESONLY=0 QUIET=0 NAMES='' WSTATE=''
parse_select() {
  while [ $# -gt 0 ]; do
    case $1 in
      -e) [ $# -ge 2 ] || sl_die "-e needs a pattern"
          if [ -z "$PATS" ]; then PATS=$2; else PATS="$PATS
$2"; fi; shift 2 ;;
      -f) [ $# -ge 2 ] || sl_die "-f needs a file"; PFILE=$2; [ -r "$PFILE" ] || sl_die "cannot read $PFILE"; shift 2 ;;
      -E) MODE=E; shift ;;  -F) MODE=F; shift ;;  -G) MODE=G; shift ;;
      -i) ICASE=1; shift ;; -v) INV=1; shift ;;  -x) WHOLE=1; shift ;;
      -c) COUNT=1; shift ;; -l) NAMESONLY=1; shift ;; -q) QUIET=1; shift ;;
      --state) [ $# -ge 2 ] || sl_die "--state needs a STATE word"; WSTATE=$2; shift 2 ;;
      -w) sl_die "-w is not offered: GNU word-matching splits names at '-' and '.'; list exact names instead" ;;
      --) shift; break ;;
      -*) sl_die "unknown option: $1" ;;
      *) break ;;
    esac
  done
  for w; do case $w in -*) sl_die "options go before names (POSIX order): $w";; esac; done
  NAMES="$*"
  if [ -n "$NAMES" ] && { [ -n "$PATS" ] || [ -n "$PFILE" ]; }; then
    sl_die "give exact NAMEs or -e/-f patterns, not both"
  fi
}

all_names() { ls "$ITEMS" 2>/dev/null | grep -E -x -e "$ITEM_RE"; }

select_names() {
  if [ -n "$NAMES" ]; then
    all_names | awk -v ws="$NAMES" -v ic=$ICASE -v inv=$INV '
      BEGIN { n = split(ws, a, " "); for (i = 1; i <= n; i++) W[ic ? tolower(a[i]) : a[i]] = 1 }
      { k = ic ? tolower($0) : $0; hit = (k in W); if (hit != inv) print }'
  elif [ -n "$PATS" ] || [ -n "$PFILE" ]; then
    fl="-$MODE"; [ $ICASE -eq 1 ] && fl="$fl -i"; [ $INV -eq 1 ] && fl="$fl -v"; [ $WHOLE -eq 1 ] && fl="$fl -x"
    if [ -n "$PFILE" ] && [ -n "$PATS" ]; then all_names | grep $fl -e "$PATS" -f "$PFILE"
    elif [ -n "$PFILE" ]; then all_names | grep $fl -f "$PFILE"
    else all_names | grep $fl -e "$PATS"; fi
  else
    if [ $INV -eq 1 ]; then :; else all_names; fi
  fi
}

# emit ITEM -> the requested view of one item (the FIELD var says which)
emit() {
  it=$1; row=$(latest "$it")
  case $FIELD in
    state) v=$(sed -n 1p "$ITEMS/$it") ;;
    row)   v=$row ;;
    cur)   v=$(field 3 "$row") ;;  last) v=$(field 4 "$row") ;;
    date)  v=$(field 5 "$row") ;;  note) v=$(field 6 "$row") ;;
  esac
  [ -n "$v" ] || v=NONE
  if [ "$FIELD" = row ] || [ "$ONE" -eq 1 ]; then printf '%s\n' "$v"; else printf '%s %s\n' "$it" "$v"; fi
}

run_select() {  # $1 = view; rest = select args
  view=$1; shift; parse_select "$@"; need_store
  sel=$(select_names)
  if [ -n "$WSTATE" ] && [ -n "$sel" ]; then   # then keep only items whose last STATE is WSTATE
    sel=$(printf '%s\n' "$sel" | while IFS= read -r it; do
            [ "$(sed -n 1p "$ITEMS/$it")" = "$WSTATE" ] && printf '%s\n' "$it"; done)
  fi
  n=0; [ -n "$sel" ] && n=$(printf '%s\n' "$sel" | wc -l | tr -d ' ')
  [ $QUIET -eq 1 ] && { [ "$n" -gt 0 ]; return; }
  [ $COUNT -eq 1 ] && { echo "$n"; [ "$n" -gt 0 ]; return; }
  [ "$n" -gt 0 ] || return 1
  [ $NAMESONLY -eq 1 ] && { printf '%s\n' "$sel"; return 0; }
  ONE=0; [ "$n" -eq 1 ] && [ -n "$NAMES" ] && ONE=1
  case $view in
    items) printf '%s\n' "$sel" ;;
    log)   echo "$HEADER"; printf '%s\n' "$sel" | awk 'NR == FNR { W[$1] = 1; next } FNR > 1 && ($1 in W)' - "$LOG" ;;
    table) printf '%s\n' "$sel" | while IFS= read -r it; do latest "$it"; done \
             | awk -v h="$HEADER" 'BEGIN { print h } { print }' \
             | awk '{ r[NR] = $0; for (i = 1; i <= 5; i++) if (length($i) > w[i]) w[i] = length($i) }
                    END { for (k = 1; k <= NR; k++) { $0 = r[k]; s = $0
                            for (i = 1; i <= 5; i++) sub(/^[^ ]+ ?/, "", s)
                            printf "%-*s  %-*s  %-*s  %-*s  %-*s  %s\n", w[1], $1, w[2], $2, w[3], $3, w[4], $4, w[5], $5, s } }' ;;
    say)   printf '%s\n' "$sel" | while IFS= read -r it; do
             row=$(latest "$it"); st=$(sed -n 1p "$ITEMS/$it")
             if [ -z "$row" ]; then echo "$it is $st, but the log has no row for it -- run check."; continue; fi
             cur=$(field 3 "$row"); last=$(field 4 "$row"); d=$(field 5 "$row"); nt=$(field 6 "$row")
             k=$(awk -v it="$it" 'NR > 1 && $1 == it { c++ } END { print c + 0 }' "$LOG")
             printf '%s is %s, last changed %s at %s UTC (%s event%s logged).' "$it" "$st" "${d%%T*}" \
               "$(printf '%s' "$d" | cut -c12-16)" "$k" "$([ "$k" -eq 1 ] || echo s)"
             if [ "$cur" = NONE ]; then printf ' No copy of it is archived.'
             else printf ' The current copy is kept at %s' "$cur"
                  if [ "$last" = NONE ]; then printf '; there is no earlier copy.'; else printf '; the one before is %s.' "$last"; fi
             fi
             [ "$nt" = - ] || printf ' Note: %s' "$nt"
             echo
           done ;;
    *)     FIELD=$view; printf '%s\n' "$sel" | while IFS= read -r it; do emit "$it"; done ;;
  esac
}

cmd_check() {
  need_store; OK=0; FAULT=0
  ck() { if [ "$1" = OK ]; then sl_tally OK; else sl_tally FAULT; printf 'FAULT  %s\n' "$2"; fi; }
  bad=$(awk -v ire="^$ITEM_RE\$" -v sre="^$STATE_RE\$" -v dre="^$DATE_RE\$" '
    NR > 1 { if (NF < 6 || $1 !~ ire || $2 !~ sre || $5 !~ dre || ($3 != "NONE" && $3 !~ /^archive\//) || ($4 != "NONE" && $4 !~ /^archive\//)) print NR ": " $0 }' "$LOG")
  if [ -z "$bad" ]; then ck OK; else ck FAULT "malformed log rows:
$bad"; fi
  for it in $(awk 'NR > 1 { print $1 }' "$LOG" | sort -u); do
    want=$(field 2 "$(latest "$it")")
    if [ ! -f "$ITEMS/$it" ]; then ck FAULT "$it: logged but skill-metrics/$it is missing"
    elif [ "$(sed -n 1p "$ITEMS/$it")" != "$want" ]; then ck FAULT "$it: skill-metrics/$it says $(sed -n 1p "$ITEMS/$it"), the log's last row says $want"
    else ck OK; fi
  done
  for it in $(all_names); do
    [ -n "$(latest "$it")" ] && continue
    ck FAULT "$it: skill-metrics/$it exists but the log never mentions it"
  done
  for p in $(awk 'NR > 1 { print $3; print $4 }' "$LOG" | grep -v -x -e NONE | sort -u); do
    if [ ! -f "$ROOT/$p" ]; then ck FAULT "$p: named in the log, not in the archive"; continue; fi
    nm=${p##*/}; h=$(printf '%s' "$nm" | cut -c1-16)
    if [ "$(sl_hash "$ROOT/$p" | cut -c1-16)" = "$h" ]; then ck OK; else ck FAULT "$p: bytes no longer match the hash in its name"; fi
  done
  echo "sk2mt check: OK $OK · FAULT $FAULT  ($ROOT)"
  [ "$FAULT" -eq 0 ]
}

case $CMD in
  init)  cmd_init ;;
  set)   cmd_set "$@" ;;
  check) cmd_check ;;
  state|cur|last|date|note|row|items|log|say|table) run_select "$CMD" "$@" ;;
  get)   run_select state "$@" ;;
  *) sl_die "unknown command: $CMD (try: sk2mt help)" ;;
esac
