#!/usr/bin/env python3
"""dr1pg -- DRIFT 1 PAGE: a drift page by formula, from what the logs already say.

usage: dr1pg ROOT --since YYYY-MM-DD [--until YYYY-MM-DD] [--out PAGE] [--title TITLE]
             [--drift-log FILE]... [--ledger FILE]... [--alto TAIL] [--capsule FILE]

Without --out the page goes to stdout and nothing is recorded.  With --out: the edition it replaces
is kept in .drift/archive/ beside PAGE, and .drift/MUTATIONS gains one line.  --capsule writes the
page's story under the wire's 32 KB cap, in 7-bit ASCII.  Disable: DR1PG=0.

Unfolded from drift.org; edit that, not this.
Copyright 2026 Corwin Brust <corwin@bru.st> and Contributors; GPL-3.0-or-later.
Mentat (for Corwin; claude-opus-5-5)
"""
import argparse, datetime, glob, hashlib, os, re, subprocess, sys

CAP = 32000  # the wire's message cap is 32 KB; a capsule stays under it
DATE = re.compile(r"(20\d\d)-?([01]\d)-?([0-3]\d)")
# A capsule travels on the wire, which has double-encoded non-ASCII into mojibake before, and a
# mangled capsule fails dr1ck's hash check as tampered.  So a capsule is 7-bit ASCII: the page's
# pilcrow becomes P (P1, P2, ...), a few marks become their plain look-alikes, the rest is escaped.
WIRE = {"\u00b6": "P", "\u00b7": "-", "\u2014": "--", "\u2013": "-", "\u2018": "'", "\u2019": "'",
        "\u201c": '"', "\u201d": '"', "\u2026": "...", "\u00a0": " "}


def clean(s, n=160):
    s = " ".join(s.replace("·", "-").split())
    return s if len(s) <= n else s[: n - 3].rstrip() + "..."


def ascii7(s0):
    s = "".join(WIRE.get(ch, ch) for ch in s0)
    return s.encode("ascii", "backslashreplace").decode("ascii")


def in_window(d, since, until):
    return since <= d <= until


def git_events(root, since, until):
    try:
        out = subprocess.run(
            ["git", "-C", root, "--no-optional-locks", "log", "--date=short", "--pretty=format:%h%x09%cd%x09%s"],
            capture_output=True, text=True, check=True).stdout
    except (OSError, subprocess.CalledProcessError):
        return None
    ev = []
    for line in out.splitlines():
        h, d, s = line.split("\t", 2)
        if not in_window(d, since, until):  # not git's --since: it stops at the first older commit
            continue
        ev.append({"kind": "git", "date": d, "where": "git " + h, "text": clean(s)})
    return list(reversed(ev))


def changelog_events(root, since, until):
    path = os.path.join(root, "ChangeLog")
    if not os.path.isfile(path):
        return None
    ev, lines = [], open(path, encoding="utf-8", errors="replace").read().split("\n")
    for i, line in enumerate(lines):
        m = re.match(r"(\d{4}-\d\d-\d\d)  (.+?)  <", line)
        if not m or not in_window(m.group(1), since, until):
            continue
        first, taking = "", False
        for nxt in lines[i + 1:]:
            t = nxt.strip()
            if re.match(r"\d{4}-\d\d-\d\d  ", nxt) or (taking and (not t or t.startswith("*"))):
                break
            if t.startswith("*") and not taking:
                first, taking = t.lstrip("* ").strip(), True
            elif taking:
                first += " " + t
        ev.append({"kind": "changelog", "date": m.group(1), "where": "ChangeLog:%d" % (i + 1),
                   "text": clean((m.group(2) + ": " + first) if first else m.group(2))})
    return list(reversed(ev))


def enhance_events(root, since, until):
    files = sorted(set(glob.glob(os.path.join(root, "*ENHANCE*.md")) + glob.glob(os.path.join(root, "*", "*ENHANCE*.md"))))
    if not files:
        return None
    ev = []
    for f in files:
        m = DATE.search(os.path.basename(f))
        if not m:
            continue
        d = "%s-%s-%s" % m.groups()
        if not in_window(d, since, until):
            continue
        for i, line in enumerate(open(f, encoding="utf-8", errors="replace"), 1):
            h = re.match(r"##+ +(\d+)\.? +(.+)", line)
            if h:
                ev.append({"kind": "enhance", "date": d, "where": "%s:%d" % (os.path.relpath(f, root), i),
                           "text": clean("note %s: %s" % (h.group(1), h.group(2)), 120)})
    return ev


def checkpoint_events(paths, since, until):
    if not paths:
        return None
    ev, seen = [], False
    for p in paths:
        if not os.path.isfile(p):
            continue
        seen = True
        for i, line in enumerate(open(p, encoding="utf-8", errors="replace"), 1):
            m = re.match(r"(\d{4}-\d\d-\d\d)T(\d\d:\d\d)Z? · checkpoint · on-bearing\? (.*?) · still-arguing\? (.*?)( · |$)", line)
            if m and in_window(m.group(1), since, until):
                ev.append({"kind": "checkpoint", "date": m.group(1), "where": "%s:%d" % (os.path.basename(p), i),
                           "text": clean("at %s: on-bearing? %s; still-arguing? %s" % (m.group(2), m.group(3), m.group(4)), 220)})
    return ev if seen else None  # a named file that is not there is NOT CHECKED, not zero


def ledger_events(paths, since, until):
    if not paths:
        return None
    ev, seen = [], False
    for p in paths:
        if not os.path.isfile(p):
            continue
        seen = True
        for i, line in enumerate(open(p, encoding="utf-8", errors="replace"), 1):
            m = re.match(r"(CONFLICT|ENHANCE) (\d{4}-\d\d-\d\d) (.+)", line.rstrip("\n"))
            if m and in_window(m.group(2), since, until):
                ev.append({"kind": "ledger", "date": m.group(2), "where": "%s:%d" % (os.path.basename(p), i),
                           "text": clean(m.group(3), 200)})
    return ev if seen else None  # a named file that is not there is NOT CHECKED, not zero


def sha(text):
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def build(a):
    root = os.path.abspath(a.root)
    title = a.title or os.path.basename(root)
    sources = [
        ("git", git_events(root, a.since, a.until)),
        ("ChangeLog", changelog_events(root, a.since, a.until)),
        ("ENHANCE notes", enhance_events(root, a.since, a.until)),
        ("DRIFT.log checkpoints", checkpoint_events(a.drift_log, a.since, a.until)),
        ("kid glove ledger", ledger_events(a.ledger, a.since, a.until)),
    ]
    events = [e for _, evs in sources if evs for e in evs]
    order = {"git": 0, "changelog": 1, "enhance": 2, "checkpoint": 3, "ledger": 4}
    events.sort(key=lambda e: (e["date"], order[e["kind"]]))
    for n, e in enumerate(events, 1):
        e["r"] = n
        e["cited"] = []
    paras = []

    def para(text, evs):
        n = len(paras) + 1
        for e in evs:
            e["cited"].append(n)
        paras.append("¶%d %s" % (n, text))

    def cite(e):
        return '"%s" [R%d]' % (e["text"], e["r"])

    happened = [e for e in events if e["kind"] in ("git", "changelog", "enhance")]
    for d in sorted({e["date"] for e in happened}):
        day = [e for e in happened if e["date"] == d]
        parts = []
        g = [e for e in day if e["kind"] == "git"]
        c = [e for e in day if e["kind"] == "changelog"]
        h = [e for e in day if e["kind"] == "enhance"]
        if g:
            parts.append("%s landed: %s." % ("one commit" if len(g) == 1 else "%d commits" % len(g), "; ".join(cite(e) for e in g)))
        if c:
            parts.append("The ChangeLog records %s: %s." % ("one entry" if len(c) == 1 else "%d entries" % len(c), "; ".join(cite(e) for e in c)))
        if h:
            parts.append("%s written: %s." % ("one ENHANCE note was" if len(h) == 1 else "%d ENHANCE notes were" % len(h), "; ".join(cite(e) for e in h)))
        text = " ".join(parts)
        para("On %s, %s" % (d, text[:1].lower() + text[1:]), day)
    first_drift = len(paras) + 1
    cps = [e for e in events if e["kind"] == "checkpoint"]
    led = [e for e in events if e["kind"] == "ledger"]
    for e in cps:
        para("On %s, a checkpoint %s [R%d]." % (e["date"], e["text"], e["r"]), [e])
    if led:
        para("The house chose, and the kid glove wrote it down once: %s." % "; ".join(cite(e) for e in led), led)
    if not cps:
        paras.append("¶%d No drift checkpoint was recorded in this window: NOT CHECKED, which is not the same as no drift." % (len(paras) + 1))

    try:
        head = subprocess.run(["git", "-C", root, "--no-optional-locks", "rev-parse", "--short", "HEAD"],
                              capture_output=True, text=True, encoding="utf-8", check=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        head = ""
    inputs = "\n".join("%s\t%s\t%s" % (e["date"], e["where"], e["text"]) for e in events)
    inputs_sha = sha(inputs)
    out = ["# Drift: %s, %s to %s" % (title, a.since, a.until), "",
           "*Pulled by dr1pg from what the logs say; regenerate, never hand-edit.  Inputs sha256 %s.*" % inputs_sha, "",
           "## What happened", ""]
    for p in paras[: first_drift - 1] or ["(nothing in this window)"]:
        out += [p, ""]
    out += ["## Where it drifted", ""]
    for p in paras[first_drift - 1:]:
        out += [p, ""]
    out += ["## Sources read", ""]
    for name, evs in sources:
        out.append("- %s: %s" % (name, "NOT CHECKED (not present)" if evs is None else "%d in the window" % len(evs)))
    if head:
        out.append("- read at git HEAD %s (a page cannot cite the commit that records it; later commits belong to the next edition)" % head)
    out += ["", "## Referents", ""]
    for e in events:
        out.append("R%d · %s · %s · %s · %s · cited by %s" % (e["r"], e["kind"], e["where"], e["date"], e["text"],
                                                               ", ".join("¶%d" % n for n in e["cited"])))
    return out, events, inputs, inputs_sha


def main():
    if os.environ.get("DR1PG", "1") == "0":
        print("dr1pg: disabled (DR1PG=0); NOT CHECKED")
        return 0
    ap = argparse.ArgumentParser(description="a drift page by formula")
    ap.add_argument("root")
    ap.add_argument("--since", required=True)
    ap.add_argument("--until", default=datetime.date.today().isoformat())
    ap.add_argument("--out")
    ap.add_argument("--title")
    ap.add_argument("--drift-log", action="append", default=[])
    ap.add_argument("--ledger", action="append", default=[])
    ap.add_argument("--alto")
    ap.add_argument("--capsule")
    a = ap.parse_args()
    if not a.drift_log and os.path.isfile(os.path.join(a.root, "DRIFT.log")):
        a.drift_log = [os.path.join(a.root, "DRIFT.log")]
    lines, events, inputs, inputs_sha = build(a)
    now = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%MZ")
    ncp = sum(1 for e in events if e["kind"] == "checkpoint")
    if not a.out:
        lines += ["", "## Mutations", "", "(not recorded: no --out)", ""]
        sys.stdout.write("\n".join(lines) + "\n")
        return 0
    d = os.path.join(os.path.dirname(os.path.abspath(a.out)), ".drift")
    os.makedirs(os.path.join(d, "archive"), exist_ok=True)
    mpath = os.path.join(d, "MUTATIONS")
    prior = [l.rstrip("\n") for l in open(mpath, encoding="utf-8")] if os.path.exists(mpath) else []
    prior = [l for l in prior if (" · page " + os.path.basename(a.out) + " · ") in l]
    ipath = os.path.join(d, "INPUTS." + os.path.basename(a.out))
    formula = "#formula " + sha(open(os.path.abspath(__file__), encoding="utf-8").read())
    def ident(line):  # a source is the same source when only its line number moved
        return re.sub(r":\d+\t", "\t", line)
    old = {ident(l) for l in open(ipath, encoding="utf-8").read().split("\n")} if os.path.exists(ipath) else set()
    new = {ident(l) for l in inputs.split("\n")} if inputs else set()
    delta = "first edition" if not prior else "%d sources added, %d gone" % (len(new - old - {formula}), len({l for l in old if not l.startswith("#formula ")} - new))
    if prior and formula not in old:
        delta += ", the formula changed"
    n = len(prior) + 1
    lines += ["", "## Mutations", ""]
    lines += [l for l in prior] or ["(none before this one)"]
    lines += ["", "This edition: M%d, %s, inputs sha256 %s; %s.  Its page hash is recorded in .drift/MUTATIONS after it is written." % (n, now, inputs_sha, delta),
              "", "## Checkpoint", "",
              "%s · checkpoint · on-bearing? %s · still-arguing? %s · grader: dr1pg · note: %d sources, %d checkpoints" % (
                  now, "see the checkpoints above" if ncp else "NOT CHECKED (none recorded)",
                  "yes, %d ledger line(s)" % sum(1 for e in events if e["kind"] == "ledger") if any(e["kind"] == "ledger" for e in events) else "none recorded",
                  len(events), ncp),
              "", "Copyright %s Corwin Brust <corwin@bru.st> and Contributors; CC-BY-SA4: https://creativecommons.org/licenses/by-sa/4.0/; Mentat (for Corwin; claude-opus-5-5)" % now[:4], ""]
    page = "\n".join(lines)
    if os.path.exists(a.out):
        oldpage = open(a.out, encoding="utf-8").read()
        if oldpage != page:
            open(os.path.join(d, "archive", sha(oldpage) + ".md"), "w", encoding="utf-8").write(oldpage)
    open(a.out, "w", encoding="utf-8").write(page)
    psha = sha(page)
    open(ipath, "w", encoding="utf-8").write(formula + "\n" + inputs)
    csha = "-"
    if a.capsule:
        body = ascii7("\n".join(lines[: lines.index("## Sources read")]).rstrip())
        head = ascii7("Drift capsule of %s (page sha256 %s), in 7-bit ASCII (P1, P2, ... are the page's paragraphs); "
                      "ask for the page for its referents.\n\n" % (os.path.basename(a.out), psha))
        cap = head + body + "\n"
        if len(cap.encode("utf-8")) > CAP:
            paras = body.split("\n\n")
            while paras and len((head + "\n\n".join(paras)).encode("utf-8")) > CAP - 200:
                paras.pop()
            cap = head + "\n\n".join(paras) + "\n\n(cut to stay under the wire's 32 KB cap; the page has the rest)\n"
        open(a.capsule, "w", encoding="utf-8").write(cap)
        csha = sha(cap)
    with open(mpath, "a", encoding="utf-8") as fh:
        fh.write("M%d · %s · page %s · sha256 %s · inputs %s · capsule %s · %s\n" % (n, now, os.path.basename(a.out), psha, inputs_sha, csha, delta))
    if a.alto:
        if os.path.isdir(os.path.dirname(os.path.abspath(a.alto))):
            with open(a.alto, "a", encoding="utf-8") as fh:
                fh.write("%s · drift page %s · sha256 %s · %d sources, %d checkpoints\n" % (now, a.out, psha, len(events), ncp))
        else:
            print("dr1pg: alto tail NOT WRITTEN: %s has no folder" % a.alto, file=sys.stderr)
    print("dr1pg: %s M%d (%s): %d sources, %d checkpoints; page sha256 %s" % (a.out, n, delta, len(events), ncp, psha))
    return 0


if __name__ == "__main__":
    sys.exit(main())
