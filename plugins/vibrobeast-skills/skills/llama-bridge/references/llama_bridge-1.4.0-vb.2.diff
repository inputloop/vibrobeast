+# vb.2 (2026-10-29, Corwin's garden, for Bryant to keep, change or flip back): two defaults that ask first.
+# KEEP_PROMPTS: whether the log and the answer cache keep the words of prompts and answers.  1.4.0 kept
+#   them (True).  vb.2 keeps times, models and sizes, not the words, unless asked.
+# STORED_HOST: what to do with an `ollama_host` row in this database's config, when the bridge runs as an
+#   MCP server.  1.4.0 used it over OLLAMA_HOST ("use").  vb.2 sends to OLLAMA_HOST unless told "use";
+#   the dashboard (gui), where the person sets that row by hand, still uses it.
+# Flip either constant here at build time to make 1.4.0's behaviour the default again.  For one run:
+#   LLAMABRIDGE_KEEP_PROMPTS=1 or --keep-prompts;  LLAMABRIDGE_STORED_HOST=use or --use-stored-host.
+KEEP_PROMPTS = False
+STORED_HOST = "ask"
+NOT_KEPT = "(not kept: keep_prompts is off)"
+
+
+def _env_on(name, default):
+    v = (os.environ.get(name) or "").strip().lower()
+    if v in ("1", "on", "true", "yes"):
+        return True
+    if v in ("0", "off", "false", "no"):
+        return False
+    return default
+
